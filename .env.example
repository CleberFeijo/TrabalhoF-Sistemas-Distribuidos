# Copie para .env e preencha. O arquivo .env NUNCA deve ir para o git.
# Gere segredos com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (use só letras, números, - e _ nas senhas: elas entram em URLs de conexão)

# ================= Aplicação
# development | production
ENV=development
# Swagger em /docs
DOCS_ENABLED=true
API_PORT=8080
# Processos do uvicorn (com mais de 1, o Redis distribui o chat entre eles)
WEB_CONCURRENCY=1
# Origens liberadas para navegador, separadas por vírgula (o app Android não precisa)
CORS_ORIGINS=

# ================= Autenticação
# Obrigatório, mínimo 32 caracteres
JWT_SECRET=
# Validade do token em minutos (7 dias)
JWT_EXPIRE_MINUTES=10080

# Administrador criado no primeiro boot (opcional; nunca sobrescreve conta existente)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ================= MongoDB
MONGO_ROOT_USER=hist
# Obrigatório
MONGO_ROOT_PASSWORD=
MONGO_DB=hist

# ================= Redis (pub/sub do chat)
# Obrigatório
REDIS_PASSWORD=

# ================= RabbitMQ / Celery (perfil "worker")
RABBITMQ_USER=hist
# Obrigatório ao usar o perfil worker
RABBITMQ_PASSWORD=

# ================= Geolocalização e chat
NEARBY_DEFAULT_RADIUS_M=200
NEARBY_MAX_RADIUS_M=50000
# Distância máxima para entrar no chat de um ponto
CHAT_JOIN_RADIUS_M=200
# Folga antes de desconectar quem se afasta (imprecisão do GPS)
CHAT_LEAVE_RADIUS_M=300
CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_RATE_LIMIT_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_S=10

# Plano premium (mensagens salvas). Estrutura pronta, mantida desligada.
CHAT_PERSISTENCE_ENABLED=false
CHAT_HISTORY_RETENTION_DAYS=30
